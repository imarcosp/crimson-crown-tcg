{
  "name": "el-perchero-tcg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/assert-deployment-environment.mjs && next build --webpack",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint",
    "update-prices": "node scripts/update-prices.mjs",
    "sync:master-healer": "node scripts/sync-master-healer-v2-compatible.mjs",
    "test:environment-safety": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types src/lib/environment/production-guards.test.ts src/lib/auth/admin-access.test.ts src/config/site.test.ts src/lib/exchange-rate.test.ts src/store/cartStore.test.ts src/app/actions/checkout-helpers.test.ts scripts/assert-safe-test-environment.test.mjs scripts/write-local-test-environment.test.mjs scripts/local-db/verify-artifact-location.test.mjs scripts/local-db/assert-local-network-isolation.test.mjs scripts/local-db/install-local-firewall-rules.test.mjs scripts/local-db/sanitize-public.test.mjs scripts/local-db/checkout-action-contract.test.mjs scripts/local-db/release-stock-route-contract.test.mjs scripts/assert-deployment-environment.test.mjs scripts/assert-vercel-environment-safety.test.mjs scripts/local-db/production-migration-readiness.test.mjs scripts/typecheck-contract.test.mjs",
    "test:deployment-safety": "node --test scripts/assert-deployment-environment.test.mjs scripts/assert-vercel-environment-safety.test.mjs",
    "test:release-manifest": "node --test scripts/release/migration-manifest.test.mjs",
    "test:release": "node --test scripts/release/*.test.mjs scripts/dependency-compatibility.test.mjs",
    "test:dependencies": "node --test scripts/dependency-compatibility.test.mjs",
    "release:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/run-linked-dry-run.ps1",
    "test:privileged-surfaces": "node --test scripts/local-db/privileged-surface-contract.test.mjs scripts/local-db/privileged-surface-verifier-contract.test.mjs scripts/local-db/authenticated-definer-contract.test.mjs",
    "verify:local-privileged-surfaces": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db/verify-privileged-surfaces.ps1",
    "test:local-authenticated-definers": "node scripts/local-db/authenticated-definer-matrix.mjs",
    "test:local-security": "node scripts/local-db/security-matrix.mjs",
    "test:local-financial": "node scripts/local-db/financial-matrix.mjs",
    "test:local-atomic-checkout": "node scripts/local-db/checkout-atomic-matrix.mjs",
    "test:local-release-stock": "node scripts/local-db/release-stock-atomic-matrix.mjs",
    "test:local-multi-inventory": "node scripts/local-db/multi-inventory-runtime-matrix.mjs",
    "test:local-admin-products": "node scripts/local-db/admin-product-mutations-matrix.mjs",
    "test:checkout-contract": "node --test scripts/local-db/checkout-action-contract.test.mjs",
    "test:local-storage": "node scripts/local-db/storage-matrix.mjs",
    "test:payment-proof-paths": "node --test scripts/local-db/payment-proof-paths-contract.test.mjs",
    "local-storage:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db/prepare-storage-fixtures.ps1",
    "local-db:prepare-artifacts": "node scripts/local-db/prepare-artifact-location.mjs",
    "local-db:assert-network": "node scripts/local-db/assert-local-network-isolation.mjs",
    "local-db:install-firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db/install-local-firewall-rules.ps1",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/assert-safe-test-environment.mjs && playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.2",
    "@types/papaparse": "^5.5.1",
    "axios": "1.20.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "framer-motion": "^12.23.25",
    "JSONStream": "^1.3.5",
    "lucide-react": "^0.555.0",
    "mercadopago": "2.12.0",
    "next": "16.3.3",
    "papaparse": "^5.5.3",
    "puppeteer": "25.9.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.6.0",
    "resend": "6.25.0",
    "stream-json": "^1.8.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.58.2",
    "supabase": "2.113.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
